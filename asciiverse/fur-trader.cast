[0.000133, "o", "2;12;12;16m  \u001b[22;3HYo\u001b[22;6H set off for Albany, by Oswego, the Great   \u001b[23;3HCarrying Place and the Mohawk.                     \u001b[23;59H\u001b[38;2;128;124;114;48;2;12;12;16m    3\u001b[23;65H\u001b[38;2;110;206;92;48;2;22;22;28m███████████████████▏      \u001b[23;95H\u001b[38;2;222;216;200;48;2;12;12;16m826\u001b[24;3H\u001b[38;2;255;176;0;48;2;12;12;16mA rival trader reached Albany first; the buyers are\u001b[25;3Hchoosy.\u001b[38;2;222;216;200;48;2;12;12;16m   \u001b[25;14H       \u001b[25;22H   \u001b[25;26H      \u001b[26;3H\u001b[38;2;255;176;0;48;2;12;12;16mShips from Europe bring word: the warehouses there\u001b[27;3Hare full of beaver.\u001b[38;2;222;216;200;48;2;12;12;16m    \u001b[27;27H  \u001b[27;30H       \u001b[27;38H   \u001b[27;42H     \u001b[28;3H\u001b[38;2;110;206;92;48;2;12;12;16mAt Albany your pelts fetch 824 livres.\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
