[8.5e-05, "o", "22;3H\u001b[38;2;255;176;0;48;2;12;12;16mA storm on the lake keeps you ashore for days: 25\u001b[23;3Hlivres more in wages.\u001b[38;2;222;216;200;48;2;12;12;16m  \u001b[23;27H       \u001b[23;35H   \u001b[23;39H     \u001b[23;45H    \u001b[24;3H\u001b[38;2;255;176;0;48;2;12;12;16mA canoe takes water in the rapids: 54 pelts are lost\u001b[24;59H\u001b[38;2;128;124;114;48;2;12;12;16m    4\u001b[24;65H\u001b[38;2;110;206;92;48;2;22;22;28m█████████████████████████▋\u001b[24;94H\u001b[38;2;222;216;200;48;2;12;12;16m1105\u001b[25;3H\u001b[38;2;255;176;0;48;2;12;12;16mto the river.\u001b[38;2;222;216;200;48;2;12;12;16m     \u001b[25;22H   \u001b[25;26H      \u001b[26;3H\u001b[38;2;255;176;0;48;2;12;12;16mShips from Europe bring word: the warehouses there\u001b[27;3Hare full of beaver.\u001b[38;2;222;216;200;48;2;12;12;16m      \u001b[27;29H    \u001b[27;34H   \u001b[27;38H   \u001b[27;42H        \u001b[27;51H   \u001b[28;3H\u001b[38;2;110;206;92;48;2;12;12;16mAt Montreal your pelts fetch 1104 livres.\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
