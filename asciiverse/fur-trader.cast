[0.016514, "o", "\u001b[7;8H\u001b[1m\u001b[38;2;255;176;0;48;2;12;12;16m◆\u001b[8;60HOn the way \u001b[22m\u001b[38;2;70;68;62;48;2;12;12;16m───\u001b[9;59H\u001b[38;2;255;176;0;48;2;22;22;28m                                        \u001b[10;62H\u001b[38;2;222;216;200;48;2;12;12;16m \u001b[10;64H        \u001b[11;59H\u001b[38;2;128;124;114;48;2;12;12;16mTo Albany, by Oswego, the Great Carrying\u001b[12;59HPlace and the Mohawk.\u001b[13;59H\u001b[38;2;222;216;200;48;2;12;12;16m   \u001b[13;63H       \u001b[13;71H    \u001b[13;76H  \u001b[13;79H   \u001b[13;83H       \u001b[13;91H   \u001b[13;95H    \u001b[14;59H      \u001b[14;66H   \u001b[14;70H   \u001b[14;74H        \u001b[14;83H      \u001b[14;90H   \u001b[14;94H   \u001b[15;59H       \u001b[15;67H    \u001b[15;72H    \u001b[15;77H \u001b[15;79H    \u001b[15;84H     \u001b[15;90H     \u001b[16;59H     \u001b[16;65H   \u001b[16;69H    \u001b[19;3H\u001b[38;2;110;206;92;48;2;12;12;16mfashion, and beaver is dear.\u001b[20;3HAt Mont\u001b[20;11Heal your pelts fetch 872 livres.\u001b[38;2;222;216;200;48;2;12;12;16m        \u001b[21;3H\u001b[38;2;96;196;222;48;2;12;12;16mAutumn of season 2. Goods are 50 livres a bale, a\u001b[22;3Hvoyageur 25.\u001b[38;2;222;216;200;48;2;12;12;16m                            \u001b["]
[7.7e-05, "o", "23;3HYou winter in the upper country and trade with Odawa\u001b[24;3Htraders who came\u001b[24;20Hdown\u001b[24;25Hby\u001b[24;28Hcanoe.\u001b[25;6Hr goods\u001b[25;14Hbrought 183 pelts.  \u001b[25;35H   \u001b[25;39H     \u001b[25;45H    \u001b[25;50H     \u001b[26;3H\u001b[38;2;96;196;222;48;2;12;12;16mSpring. The ice is out. Where will you sell?\u001b[27;6H\u001b[38;2;222;216;200;48;2;12;12;16m set off f\u001b[27;17Hr Albany, by Oswego,\u001b[27;38Hthe\u001b[27;42HGreat\u001b[28;3HCarrying Place and the Mohawk.              \u001b[30;2H\u001b[1m\u001b[38;2;255;176;0;48;2;22;22;28mEnter\u001b[22m\u001b[38;2;128;124;114;48;2;22;22;28m go on\u001b[30;15H\u001b[1m\u001b[38;2;255;176;0;48;2;22;22;28m?\u001b[22m\u001b[38;2;128;124;114;48;2;22;22;28m rules \u001b[30;24H\u001b[1m\u001b[38;2;255;176;0;48;2;22;22;28mM\u001b[22m\u001b[38;2;128;124;114;48;2;22;22;28m so\u001b[30;29Hnd \u001b[30;33H\u001b[1m\u001b[38;2;255;176;0;48;2;22;22;28mEsc\u001b[22m\u001b[38;2;128;124;114;48;2;22;22;28m q\u001b[30;39Hit\u001b[30;43H   \u001b[30;47H    \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
